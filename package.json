{
  "name": "codexplus",
  "version": "0.1.0",
  "description": "通过 C/S 架构集中管理 Codex 凭证，在本机交互式切换账号",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/app-server",
    "packages/tui"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx --conditions=source packages/tui/src/cli.ts --home .codexplus",
    "dev:server": "tsx --conditions=source packages/app-server/src/cli.ts --home .codexplus",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --conditions=source --test test/*.test.ts packages/*/test/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weiguangchao/codexplus.git"
  },
  "license": "MIT",
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
